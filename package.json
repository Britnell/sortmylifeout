{
  "name": "sortmylife",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "migration": "wrangler d1 execute sortinglifedb --file=src/db/migration.sql --remote",
    "deploy": "bun run build && wrangler deploy",
    "logs": "wrangler tail",
    "secrets": "wrangler secret bulk .dev.vars",
    "doctor": "npx -y react-doctor . --verbose --yes --fail-on error",
    "health": "npx fallow health",
    "dead": "npx fallow dead-code",
    "dupes": "npx fallow dupes",
    "test:wazap": "bun scripts/test-wazap.ts"
  },
  "dependencies": {
    "@cloudflare/tanstack-ai": "^0.1.10",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.14.0",
    "@tanstack/ai-openrouter": "^0.8.5",
    "@tanstack/ai-react": "^0.8.2",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-router": "1.166.8",
    "@tanstack/react-router-devtools": "1.166.9",
    "@tanstack/react-router-ssr-query": "1.166.9",
    "@tanstack/react-start": "1.166.14",
    "@tanstack/router-plugin": "1.166.12",
    "better-auth": "^1.7.2",
    "jotai": "^2.20.3",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2"
  },
  "overrides": {
    "@tanstack/router-core": "1.166.7"
  },
  "resolutions": {
    "@tanstack/router-core": "1.166.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fallow": "^2.104.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.0.47",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  }
}
